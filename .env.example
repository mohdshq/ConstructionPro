# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RevenueCat (currently hardcoded in app/_layout.tsx — will be migrated)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your_revenuecat_ios_key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your_revenuecat_android_key

# Set to "true" to bypass paywall in development builds.
# Has NO effect in production (__DEV__ === false).
EXPO_PUBLIC_DEV_FORCE_PREMIUM=

# Sentry Configuration
# Add your real EXPO_PUBLIC_SENTRY_DSN in .env (safe for client side)
EXPO_PUBLIC_SENTRY_DSN=

# Uncomment to force Sentry on during local development for testing
# EXPO_PUBLIC_SENTRY_FORCE_ENABLE=true

# NOTE: SENTRY_AUTH_TOKEN is a build-time secret used for uploading sourcemaps.
# DO NOT add it to version control! Add it to EAS Secrets instead.

# PostHog Configuration
# Add your real EXPO_PUBLIC_POSTHOG_KEY and EXPO_PUBLIC_POSTHOG_HOST in .env
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Uncomment to force PostHog on during local development for testing
# EXPO_PUBLIC_POSTHOG_FORCE_ENABLE=true
