# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RevenueCat (currently hardcoded in app/_layout.tsx — will be migrated)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your_revenuecat_ios_key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your_revenuecat_android_key

# Set to "true" to bypass paywall in development builds.
# Has NO effect in production (__DEV__ === false).
EXPO_PUBLIC_DEV_FORCE_PREMIUM=
