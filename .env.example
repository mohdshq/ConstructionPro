# =============================================================================
# ConstructionPro — Environment Configuration Example
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All variables prefixed with EXPO_PUBLIC_ are exposed to the client bundle.
# Keep secrets (anything sensitive) OFF the client — use Supabase Edge Functions.
# =============================================================================

# ---- Supabase (Phase 1) -----------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ---- RevenueCat (in-app purchases) ------------------------------------------
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Sentry (crash & error reporting) ---------------------------------------
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxx

# ---- Feature flags ----------------------------------------------------------
# Set to "true" to enable AI features that talk to our backend proxy.
EXPO_PUBLIC_AI_ENABLED=true

# =============================================================================
# Server-side ONLY (used by Supabase Edge Functions — NOT exposed to client)
# Configure these in the Supabase dashboard under Project Settings → Functions.
# =============================================================================
# GEMINI_API_KEY=                  # Google Generative AI key (server-side proxy)
# OPENWEATHER_API_KEY=             # Weather auto-fill for daily reports
# RESEND_API_KEY=                  # Email delivery (PDF reports)
