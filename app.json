{
  "expo": {
    "name": "ConstructionPro",
    "slug": "ConstructionPro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "constructionpro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohammedsh.constructionpro",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ConstructionPro requires camera access to capture photos for site snagging and daily reports.",
        "NSPhotoLibraryUsageDescription": "ConstructionPro needs access to your photo library to attach existing images to reports and update your profile picture.",
        "NSMicrophoneUsageDescription": "ConstructionPro needs access to your microphone to record conversational AI voice notes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mohammedsh.constructionpro",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "ConstructionPro needs access to your microphone to record voice notes for quick logs."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "paltech-jd",
          "project": "constructionpro",
          "url": "https://de.sentry.io/"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7d1fad6-a970-4b29-9cb9-fe56475116c5"
      }
    }
  }
}
